# PostgreSQL connection string
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Session lifetime in seconds (default 8h) and client idle timeout in minutes
SESSION_MAX_AGE=28800
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Default admin created by the seed script (forced password change on first login)
SEED_ADMIN_EMAIL="admin@company.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# In-process daily attendance job (00:05 IST). Set to "false" when using an external cron
# (e.g. Vercel Cron hitting /api/cron/daily with the CRON_SECRET bearer token).
ENABLE_CRON="true"
CRON_SECRET="change-me-cron-secret"

# Optional SMTP for password-reset emails. If unset, reset links are written to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Attendance <no-reply@company.local>"

# Directory for scripts/backup.ts output
BACKUP_DIR="./backups"
